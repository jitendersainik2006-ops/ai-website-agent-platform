SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_EXPIRY_MINUTES=30
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_agent_platform
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Optional general-purpose AI provider (options: local, gemini, groq, openai_compatible)
# Defaults to "local" deterministic mode when no provider key is configured.
LLM_PROVIDER=local
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_COMPATIBLE_API_KEY=replace-with-api-key
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_MODEL=llama-3.3-70b-versatile
LLM_REQUEST_TIMEOUT_SECONDS=10

# Optional web search augmentation (disabled by default)
WEB_SEARCH_ENABLED=false
